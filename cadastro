<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar Pet</title>

    <link rel="stylesheet" href="../css/style.css">
</head>

<body>

<header>
    <h1>Cadastro de Pets</h1>
</header>

<nav>
    <a href="../index.html">Home</a>
    <a href="cadastro.html">Cadastrar Pet</a>
    <a href="pets.html">Pets Perdidos</a>
</nav>

<section class="banner">

    <div class="card">

        <h2>Cadastrar Animal</h2>

        <form id="formPet">

            <input 
                type="text" 
                id="nome" 
                placeholder="Nome do pet"
            >

            <input 
                type="text" 
                id="raca" 
                placeholder="Raça"
            >

            <input 
                type="text" 
                id="telefone" 
                placeholder="Telefone para contato"
            >

            <textarea 
                id="descricao" 
                placeholder="Descrição do desaparecimento"
            ></textarea>

            <input 
                type="file" 
                id="foto"
                accept="image/*"
            >

            <br><br>

            <button type="submit">
                Cadastrar Pet
            </button>

        </form>

    </div>

</section>

<script src="../js/script.js"></script>

</body>
</html>
