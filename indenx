<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Alerta de Pets Perdidos</title>

    <style>

        body{
            margin:0;
            font-family: Arial;
            background-color:#f4f4f4;
        }

        header{
            background-color:#ff914d;
            color:white;
            padding:20px;
            text-align:center;
        }

        nav{
            background-color:#333;
            padding:10px;
            text-align:center;
        }

        nav a{
            color:white;
            text-decoration:none;
            margin:15px;
            font-weight:bold;
        }

        .banner{
            padding:50px;
            text-align:center;
            background-color:white;
        }

        .banner h1{
            color:#ff914d;
        }

        .cards{
            display:flex;
            justify-content:center;
            gap:20px;
            margin-top:30px;
        }

        .card{
            background-color:white;
            padding:20px;
            width:220px;
            border-radius:10px;
            box-shadow:0px 0px 5px gray;
            text-align:center;
        }

        .card button{
            background-color:#ff914d;
            color:white;
            border:none;
            padding:10px;
            border-radius:5px;
            cursor:pointer;
        }

    </style>
</head>

<body>

<header>
    <h1>Alerta de Pets Perdidos</h1>
</header>

<nav>
    <a href="">Home</a>
    
    <a href="pages/cadastro.html">Cadastrar Pet</a>
    <a href="pages/pets.html">Pets Perdidos</a>
    
    <a href="">Contato</a>
</nav>

<section class="banner">

    <h1>Ajude um pet a voltar para casa 🐶</h1>

    <p>
        Sistema para divulgação de animais perdidos.
    </p>

    <div class="cards">

        <div class="card">
            <h3>Perdi meu pet</h3>
            <p>Cadastre um animal desaparecido.</p>
            
            <a href="pages/cadastro.html">
            <button>Registrar</button>
        </a>

        </div>

        <div class="card">
            <h3>Encontrei um pet</h3>
            <p>Ajude a localizar o dono.</p>
            <a href="pages/cadastro.html">
            <button>Informar</button>
            </a>

        </div>

    </div>

</section>

</body>
</html>
